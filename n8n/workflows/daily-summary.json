{
  "name": "Daily Spending Summary",
  "nodes": [
    {
      "id": "c3d4e5f6-0001-4000-8000-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 20 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "c3d4e5f6-0002-4000-8000-000000000002",
      "name": "Get Dashboard Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "finance-api-key",
          "name": "Finance Backend API"
        }
      },
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_URL }}/api/v1/dashboard/summary",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "year",
              "value": "={{ new Date().getFullYear() }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "c3d4e5f6-0003-4000-8000-000000000003",
      "name": "Get AI Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "finance-api-key",
          "name": "Finance Backend API"
        }
      },
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_URL }}/api/v1/ai/summary",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "startDate",
              "value": "={{ (() => { const d = new Date(); d.setHours(0,0,0,0); return d.toISOString(); })() }}"
            },
            {
              "name": "endDate",
              "value": "={{ (() => { const d = new Date(); d.setHours(23,59,59,999); return d.toISOString(); })() }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "c3d4e5f6-0004-4000-8000-000000000004",
      "name": "Merge Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [750, 300],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      }
    },
    {
      "id": "c3d4e5f6-0005-4000-8000-000000000005",
      "name": "Format Daily Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 300],
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// items[0] = dashboard summary, items[1] = AI summary\nconst dashData = items[0]?.json?.data || {};\nconst aiData = items[1]?.json?.data || {};\n\nconst today = new Date();\nconst dateStr = today.toLocaleDateString('id-ID', {\n  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',\n  timeZone: 'Asia/Jakarta',\n});\n\nfunction formatRupiah(amount) {\n  return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(amount || 0);\n}\n\nconst totalSpent = dashData.totalAmount || 0;\nconst txCount = dashData.transactionCount || 0;\nconst aiSummary = aiData.summary || 'No AI summary available.';\n\nconst emailSubject = `Daily Finance Summary — ${dateStr}`;\n\nconst emailBody = `\n<h2>Daily Finance Summary</h2>\n<p><strong>Date:</strong> ${dateStr}</p>\n<hr>\n<h3>Today's Activity</h3>\n<ul>\n  <li><strong>Total Spent (YTD):</strong> ${formatRupiah(totalSpent)}</li>\n  <li><strong>Total Transactions (YTD):</strong> ${txCount}</li>\n</ul>\n<hr>\n<h3>AI Spending Insights</h3>\n<p>${aiSummary}</p>\n<hr>\n<p style=\"color: #999; font-size: 12px;\">This is an automated daily report from your Finance Automation System.</p>\n`.trim();\n\nreturn [{\n  json: {\n    subject: emailSubject,\n    body: emailBody,\n    dashData,\n    aiSummary,\n  }\n}];\n"
      }
    },
    {
      "id": "c3d4e5f6-0006-4000-8000-000000000006",
      "name": "Send Daily Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1250, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-oauth2",
          "name": "Gmail OAuth2 Account"
        }
      },
      "parameters": {
        "resource": "message",
        "operation": "send",
        "toList": "={{ $vars.SUMMARY_EMAIL_TO }}",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.body }}",
        "options": {
          "isHtml": true
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get Dashboard Summary",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get AI Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Dashboard Summary": {
      "main": [
        [
          {
            "node": "Merge Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get AI Summary": {
      "main": [
        [
          {
            "node": "Merge Results",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge Results": {
      "main": [
        [
          {
            "node": "Format Daily Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Daily Report": {
      "main": [
        [
          {
            "node": "Send Daily Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "c3d4e5f6-f003-4000-8000-000000000000"
}
