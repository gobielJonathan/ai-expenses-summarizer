  "nodes": [
    {
      "id": "wa-0001-4000-8000-000000000001",
      "name": "WhatsApp Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "parameters": {
        "path": "whatsapp-assistant",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "wa-0002-4000-8000-000000000002",
      "name": "Extract Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300],
      "parameters": {
        "jsCode": "// Handle Meta WhatsApp Cloud API webhook verification and messages\nconst body = $input.first().json.body;\n\n// Webhook verification challenge\nif ($input.first().json.query?.['hub.mode'] === 'subscribe') {\n  return [{ json: { isVerification: true, challenge: $input.first().json.query['hub.challenge'] } }];\n}\n\n// Extract message from Meta Cloud API payload\nconst entry = body?.entry?.[0];\nconst change = entry?.changes?.[0];\nconst message = change?.value?.messages?.[0];\n\nif (!message) {\n  return [{ json: { skip: true } }];\n}\n\nconst phone = message.from; // e.g. '628123456789'\nconst text = message.text?.body?.trim().toLowerCase() ?? '';\nconst messageId = message.id;\nconst businessPhone = change?.value?.metadata?.display_phone_number ?? '';\n\nreturn [{ json: { phone, text, messageId, businessPhone, skip: false, isVerification: false } }];\n"
      }
    },
    {
      "id": "wa-0003-4000-8000-000000000003",
      "name": "Webhook Verification?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [750, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "id": "cond-verify",
              "leftValue": "={{ $json.isVerification }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      }
    },
    {
      "id": "wa-0004-4000-8000-000000000004",
      "name": "Respond With Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1000, 150],
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.challenge }}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "wa-0005-4000-8000-000000000005",
      "name": "Skip Empty?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1000, 400],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "id": "cond-skip",
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      }
    },
    {
      "id": "wa-0006-4000-8000-000000000006",
      "name": "Verify Phone",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1250, 500],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_URL }}/api/v1/whatsapp/lookup",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Webhook-Secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "phoneNumber", "value": "={{ '+' + $json.phone }}" }
          ]
        },
        "options": {
          "response": { "response": { "responseFormat": "json" } }
        }
      }
    },
    {
      "id": "wa-0007-4000-8000-000000000007",
      "name": "Is Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1500, 500],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "id": "cond-auth",
              "leftValue": "={{ $json.data.authorized }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      }
    },
    {
      "id": "wa-0008-4000-8000-000000000008",
      "name": "Send Unauthorized Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1750, 350],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Meta WhatsApp API"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.WHATSAPP_PHONE_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $('Extract Message').item.json.phone }}\",\n  \"type\": \"text\",\n  \"text\": { \"body\": \"Your number is not linked to any account. Please visit {{ $env.FRONTEND_URL }}/settings to link your WhatsApp number.\" }\n}",
        "options": {}
      }
    },
    {
      "id": "wa-0009-4000-8000-000000000009",
      "name": "Detect Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1750, 650],
      "parameters": {
        "jsCode": "const text = $('Extract Message').item.json.text;\nconst phone = $('Extract Message').item.json.phone;\n\nlet intent = 'unknown';\nlet category = '';\n\nif (/^(summary|pengeluaran hari ini|today)/.test(text)) intent = 'summary';\nelse if (/monthly|bulanan/.test(text)) intent = 'monthly_summary';\nelse if (/bank/.test(text)) intent = 'bank_summary';\nelse if (/payment type|credit|debit/.test(text)) intent = 'payment_summary';\nelse if (/statement/.test(text)) intent = 'statement';\nelse if (/top categor|kategori/.test(text)) intent = 'monthly_summary';\nelse {\n  // Try to detect category query e.g. \"food expenses\" or \"transport this month\"\n  const categoryMatch = text.match(/^([a-z\\s]+?)\\s+(expense|pengeluaran|spending)/);\n  if (categoryMatch) {\n    intent = 'category_summary';\n    category = categoryMatch[1].trim();\n  }\n}\n\nreturn [{ json: { intent, category, phone: '+' + phone } }];\n"
      }
    },
    {
      "id": "wa-000a-4000-8000-00000000000a",
      "name": "Route Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [2000, 650],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            { "conditions": { "options": {}, "conditions": [{ "id": "r1", "leftValue": "={{ $json.intent }}", "rightValue": "summary", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "summary" },
            { "conditions": { "options": {}, "conditions": [{ "id": "r2", "leftValue": "={{ $json.intent }}", "rightValue": "monthly_summary", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "monthly" },
            { "conditions": { "options": {}, "conditions": [{ "id": "r3", "leftValue": "={{ $json.intent }}", "rightValue": "category_summary", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "category" },
            { "conditions": { "options": {}, "conditions": [{ "id": "r4", "leftValue": "={{ $json.intent }}", "rightValue": "bank_summary", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "bank" },
            { "conditions": { "options": {}, "conditions": [{ "id": "r5", "leftValue": "={{ $json.intent }}", "rightValue": "payment_summary", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "payment" }
          ]
        },
        "fallbackOutput": "extra"
      }
    },
    {
