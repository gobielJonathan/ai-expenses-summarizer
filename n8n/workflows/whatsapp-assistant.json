    {
      "id": "wa-0010-4000-8000-000000000010",
      "name": "Format Summary Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2500, 400],
      "parameters": {
        "jsCode": "const d = $input.first().json.data;\nfunction rp(n) { return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(n || 0); }\nconst cats = (d.categories || []).slice(0, 5).map((c, i) => `${i + 1}. ${c.category} ${rp(c.total)}`).join('\\n');\nconst msg = `📊 *Today's Expenses*\\n\\nTotal: ${rp(d.total)}\\nTransactions: ${d.transactionCount}\\n\\n*Top Categories:*\\n${cats || 'No data'}`;\nreturn [{ json: { reply: msg } }];\n"
      }
    },
    {
      "id": "wa-0011-4000-8000-000000000011",
      "name": "Format Monthly Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2500, 550],
      "parameters": {
        "jsCode": "const d = $input.first().json.data;\nfunction rp(n) { return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(n || 0); }\nconst start = new Date(d.period?.start);\nconst monthLabel = start.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });\nconst cats = (d.categories || []).slice(0, 5).map((c, i) => `${i + 1}. ${c.category} ${rp(c.total)}`).join('\\n');\nconst pay = (d.paymentBreakdown || []).map(p => `${p.paymentType}: ${p.percentage}%`).join(' · ');\nconst msg = `📅 *Monthly Summary — ${monthLabel}*\\n\\nTotal: ${rp(d.total)}\\nTransactions: ${d.transactionCount}\\n\\n*Top Categories:*\\n${cats || 'No data'}\\n\\n*Payment Types:*\\n${pay || 'No data'}`;\nreturn [{ json: { reply: msg } }];\n"
      }
    },
    {
      "id": "wa-0012-4000-8000-000000000012",
      "name": "Format Category Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2500, 700],
      "parameters": {
        "jsCode": "const d = $input.first().json.data;\nfunction rp(n) { return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(n || 0); }\nconst merchants = (d.merchants || []).slice(0, 5).map(m => `- ${m.merchant} ${rp(m.total)}`).join('\\n');\nconst msg = `🏷️ *${d.category} Expenses*\\n\\nTotal: ${rp(d.total)}\\nTransactions: ${d.transactionCount}\\n\\n*Top Merchants:*\\n${merchants || 'No data'}`;\nreturn [{ json: { reply: msg } }];\n"
      }
    },
    {
      "id": "wa-0013-4000-8000-000000000013",
      "name": "Format Bank Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2500, 850],
      "parameters": {
        "jsCode": "const d = $input.first().json.data;\nfunction rp(n) { return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(n || 0); }\nconst banks = (d.banks || []).map(b => `🏦 *${b.bankType}*: ${rp(b.total)} (${b.transactionCount} txns)`).join('\\n');\nconst msg = `🏦 *Expenses by Bank*\\n\\n${banks || 'No data'}`;\nreturn [{ json: { reply: msg } }];\n"
      }
    },
    {
      "id": "wa-0014-4000-8000-000000000014",
      "name": "Format Payment Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2500, 1000],
      "parameters": {
        "jsCode": "const d = $input.first().json.data;\nfunction rp(n) { return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(n || 0); }\nconst items = (d.paymentTypes || []).map(p => `💳 *${p.paymentType}*: ${rp(p.total)} — ${p.percentage}%`).join('\\n');\nconst msg = `💳 *Payment Type Breakdown*\\n\\n${items || 'No data'}`;\nreturn [{ json: { reply: msg } }];\n"
      }
    },
    {
      "id": "wa-0015-4000-8000-000000000015",
      "name": "Unknown Command Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2500, 1150],
      "parameters": {
        "jsCode": "const msg = `🤖 *Finance Assistant*\\n\\nAvailable commands:\\n• *summary* — today's expenses\\n• *monthly summary* — this month\\n• *expenses by bank* — per bank\\n• *credit expenses* / *debit expenses* — by payment type\\n• *[category] expenses* — e.g. \"food expenses\"\\n• *show statements* — latest statements`;\nreturn [{ json: { reply: msg } }];\n"
      }
    },
