{
  "name": "Monthly Spending Report",
  "nodes": [
    {
      "id": "d4e5f6a7-0001-4000-8000-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 1 * *"
            }
          ]
        }
      }
    },
    {
      "id": "d4e5f6a7-0002-4000-8000-000000000002",
      "name": "Compute Previous Month",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300],
      "parameters": {
        "jsCode": "const now = new Date();\nconst prevMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1);\nconst lastDayOfPrevMonth = new Date(now.getFullYear(), now.getMonth(), 0);\n\nconst year = prevMonth.getFullYear();\nconst month = prevMonth.getMonth() + 1;\n\nconst monthName = prevMonth.toLocaleDateString('id-ID', { month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' });\n\nreturn [{\n  json: {\n    year: String(year),\n    month: String(month),\n    startDate: prevMonth.toISOString(),\n    endDate: lastDayOfPrevMonth.toISOString(),\n    monthName,\n  }\n}];\n"
      }
    },
    {
      "id": "d4e5f6a7-0003-4000-8000-000000000003",
      "name": "Get Monthly Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [750, 150],
      "credentials": {
        "httpHeaderAuth": {
          "id": "finance-api-key",
          "name": "Finance Backend API"
        }
      },
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_URL }}/api/v1/dashboard/summary",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "year",
              "value": "={{ $json.year }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "d4e5f6a7-0004-4000-8000-000000000004",
      "name": "Get Top Categories",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [750, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "finance-api-key",
