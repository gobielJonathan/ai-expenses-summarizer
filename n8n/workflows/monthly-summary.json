            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "d4e5f6a7-0007-4000-8000-000000000007",
      "name": "Merge All Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1000, 380],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      }
    },
    {
      "id": "d4e5f6a7-0008-4000-8000-000000000008",
      "name": "Format Monthly Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 380],
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Retrieve previous month metadata from earlier node\nconst prevMonth = $('Compute Previous Month').item.json;\n\n// Parse each merged item (order: summary, top-categories, banks, ai-narrative)\nconst summary = items[0]?.json?.data || {};\nconst topCategories = items[1]?.json?.data || [];\nconst bankBreakdown = items[2]?.json?.data || [];\nconst aiNarrative = items[3]?.json?.data?.summary || 'AI narrative not available.';\n\nfunction formatRupiah(amount) {\n  return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(amount || 0);\n}\n\n// Build categories table rows\nconst categoryRows = (Array.isArray(topCategories) ? topCategories : []).slice(0, 10)\n  .map((c, i) => `<tr><td>${i + 1}</td><td>${c.category || '-'}</td><td>${formatRupiah(c.total || c.amount)}</td><td>${c.count || '-'} txn</td></tr>`)\n  .join('');\n\n// Build bank rows\nconst bankRows = (Array.isArray(bankBreakdown) ? bankBreakdown : [])\n  .map(b => `<tr><td>${b.bankType || '-'}</td><td>${formatRupiah(b.total || b.amount)}</td><td>${b.count || '-'} txn</td></tr>`)\n  .join('');\n\nconst subject = `Monthly Finance Report — ${prevMonth.monthName}`;\n\nconst body = `\n<h2>Monthly Finance Report</h2>\n<p><strong>Period:</strong> ${prevMonth.monthName}</p>\n<hr>\n\n<h3>Summary</h3>\n<ul>\n  <li><strong>Total Spending:</strong> ${formatRupiah(summary.totalAmount)}</li>\n  <li><strong>Total Transactions:</strong> ${summary.transactionCount || 0}</li>\n  <li><strong>Debit:</strong> ${formatRupiah(summary.totalDebit)}</li>\n  <li><strong>Credit:</strong> ${formatRupiah(summary.totalCredit)}</li>\n</ul>\n<hr>\n\n<h3>Top Spending Categories</h3>\n<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse;width:100%;\">\n  <thead>\n    <tr style=\"background:#f0f0f0;\"><th>#</th><th>Category</th><th>Amount</th><th>Transactions</th></tr>\n  </thead>\n  <tbody>${categoryRows || '<tr><td colspan=\"4\">No data</td></tr>'}</tbody>\n</table>\n<hr>\n\n<h3>Spending by Bank</h3>\n<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse;width:100%;\">\n  <thead>\n    <tr style=\"background:#f0f0f0;\"><th>Bank</th><th>Total</th><th>Transactions</th></tr>\n  </thead>\n  <tbody>${bankRows || '<tr><td colspan=\"3\">No data</td></tr>'}</tbody>\n</table>\n<hr>\n\n<h3>AI Financial Insights</h3>\n<p>${aiNarrative}</p>\n<hr>\n<p style=\"color:#999;font-size:12px;\">This is an automated monthly report from your Finance Automation System.</p>\n`.trim();\n\nreturn [{ json: { subject, body } }];\n"
      }
    },
    {
      "id": "d4e5f6a7-0009-4000-8000-000000000009",
      "name": "Send Monthly Email",
      "type": "n8n-nodes-base.gmail",
