      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-oauth2",
          "name": "Gmail OAuth2 Account"
        }
      },
      "parameters": {
        "resource": "message",
        "operation": "send",
        "toList": "={{ $vars.SUMMARY_EMAIL_TO }}",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.body }}",
        "options": {
          "isHtml": true
        }
      }
    }
  ],
